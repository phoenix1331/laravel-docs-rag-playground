APP_NAME="Laravel Docs RAG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Host ports published by docker-compose.yml
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6379

# AI provider keys - only the providers you select below need a key
VOYAGEAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434

# Embeddings (see config/rag.php)
# RAG_EMBEDDING_PROVIDER: voyageai|openai|gemini|mistral|cohere|jina|ollama|openrouter|fake
# RAG_EMBEDDING_MODEL: leave empty for the provider default, e.g.
#   voyageai=voyage-4 | openai=text-embedding-3-small | gemini=gemini-embedding-2 | mistral=mistral-embed-2312
#   cohere=embed-v4.0 | jina=jina-embeddings-v4 | ollama=nomic-embed-text | fake=offline word hashing, no key
# RAG_EMBEDDING_DIMENSIONS: must be 2000 or less (pgvector HNSW limit) and supported by the model, e.g.
#   voyageai=1024 | openai=1536 | gemini=1536 | mistral=1024 | cohere=1536 | jina=1024 | ollama nomic-embed-text=768
# Changing provider, model or dimensions needs "make fresh" and a fresh ingest: vectors are not comparable across models.
RAG_EMBEDDING_PROVIDER=voyageai
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=1024

# Embedding rate limits (0 = unlimited). Voyage without a payment method allows 3 RPM / 10K TPM:
#   RAG_EMBEDDING_BATCH_TOKENS=8000, RAG_EMBEDDING_RPM=2, RAG_EMBEDDING_TPM=9000, RAG_INGEST_WORKERS=1
# RPM is set one below the limit so questions (which skip the throttle) still get through during an ingest.
# Tokens are estimated at 4 characters each; Voyage counts about 16% fewer, which leaves headroom.
RAG_EMBEDDING_BATCH_TOKENS=0
RAG_EMBEDDING_RPM=0
RAG_EMBEDDING_TPM=0

# Answers (see config/rag.php)
# RAG_CHAT_PROVIDER: anthropic|openai|gemini|groq|mistral|deepseek|xai|openrouter|ollama|fake
# RAG_CHAT_MODEL: leave empty for the provider default, e.g.
#   anthropic=claude-sonnet-5-5 | openai=gpt-6.1-sol | gemini=gemini-3.8-flash | groq=openai/gpt-oss-120b
#   ollama=qwen3.5:4b | fake=offline templated answer from the top sections, no key
# Free to test: gemini and groq have free tiers; ollama and fake run locally.
# RAG_CHAT_FALLBACK_PROVIDER / RAG_CHAT_FALLBACK_MODEL: optional provider to fail over to, e.g. groq
RAG_CHAT_PROVIDER=anthropic
RAG_CHAT_MODEL=
RAG_CHAT_FALLBACK_PROVIDER=
RAG_CHAT_FALLBACK_MODEL=

# Retrieval
# RAG_RETRIEVAL_MODE: vector|hybrid
RAG_RETRIEVAL_MODE=vector
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.3

# Ingestion: Horizon worker processes (keep low on free embedding tiers)
RAG_INGEST_WORKERS=2
