APP_NAME="Laravel Docs RAG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Host ports published by docker-compose.yml
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6379

# AI providers - Voyage AI for embeddings and Anthropic for answers by default
VOYAGEAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# RAG settings (see config/rag.php)
# To use OpenAI instead:
#   RAG_EMBEDDING_PROVIDER=openai, RAG_EMBEDDING_MODEL=text-embedding-3-small, RAG_EMBEDDING_DIMENSIONS=1536
#   RAG_CHAT_PROVIDER=openai, RAG_CHAT_MODEL=<an openai chat model>
# Changing the embedding model or dimensions requires "make fresh" and a fresh ingest.
RAG_EMBEDDING_PROVIDER=voyageai
RAG_EMBEDDING_MODEL=voyage-4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_CHAT_PROVIDER=anthropic
RAG_CHAT_MODEL=claude-opus-5-5
RAG_RETRIEVAL_MODE=vector
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.3
